# API
PORT=3001
# The API only answers pages on this machine (CORS + Origin/Host checks). To edit from a phone on the LAN, run
# `npm run dev -- --host` and list that page's origin here, e.g. ALLOWED_ORIGINS=http://192.168.1.5:5173
ALLOWED_ORIGINS=
DATABASE_URL=postgres://captions:captions@localhost:5433/captions

# Retention (spec rows 2, 18): projects not opened for this many days are deleted with their files, on boot and hourly. 0 = off.
RETENTION_DAYS=30

# Opt-in usage analytics (PostHog HTTP capture, no SDK): baked into the web build; sent only after the viewer clicks Allow.
# Leave empty and the consent banner says analytics is off.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Everything heavy lives on the SSD (uploads, renders, models, db/minio volumes)
DATA_DIR=/Volumes/PortableSSD/Bong/captions-clone-data

# Object storage (MinIO in dev, R2/S3 in prod). dev:server uses it only when S3_ENDPOINT is exported (nothing loads this file
# for npm scripts; compose sets it for `make up`); empty = files under DATA_DIR. A database keeps the store it first booted with.
# R2: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto. Local scratch is a sabi-work folder inside WORK_DIR
# (default $TMPDIR); files nothing touched for an hour are swept at boot.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=captions
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# Durable jobs (BullMQ). Set → jobs survive an API restart (captions/plan/render re-run; paid B-roll/generate jobs fail
# "interrupted" instead of charging fal twice); empty = in-process jobs. `make db` runs Redis on localhost:6379.
REDIS_URL=

# Self-hosted AI (Apple Silicon Mac)
WHISPERX_URL=http://localhost:8010
OLLAMA_URL=http://localhost:11434
# Ollama CLI (`brew install ollama`, not the menu-bar app) → `npm run ai:ollama` → `ollama pull qwen2.5:3b` (blobs land on the SSD)
# qwen2.5:7b (4.7 GB) is the translation-quality upgrade.
OLLAMA_MODEL=qwen2.5:3b
# The Ollama binary when it isn't on PATH. This Mac: the official macOS tarball in ~/SabiDev/bin/ollama-dist
# (sha256 checked against the release's sha256sum.txt), so nothing lands on the Mac disk. Unset = `ollama` on PATH.
OLLAMA_BIN=

# Hosted generation + stock (per-project "Media source" decides which is used)
# fal.ai (Media source "Generate"): fal-ai/flux/schnell ≈ $0.003/image, kling-video v1.6 standard image-to-video ≈ $0.25 per 5 s clip
# (at most one video beat per project). Unset = generate-mode B-roll fails with generator_unavailable.
FAL_KEY=
# Pexels (Media source "Stock only", and the fallback when fal fails): free key at https://www.pexels.com/api/ (200 req/h).
PEXELS_KEY=
# Monthly cap on fal spend in cents, web and agent alike (UTC months). Unset or empty = 2000 ($20); 0 = no cap.
SPEND_CAP_CENTS=2000
