# API
PORT=3001
DATABASE_URL=postgres://captions:captions@localhost:5432/captions

# Everything heavy lives on the SSD (uploads, renders, models, db/minio volumes)
DATA_DIR=/Volumes/PortableSSD/Bong/captions-clone-data

# Object storage (MinIO in dev, R2/S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=captions
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345

# Self-hosted AI (Apple Silicon Mac)
WHISPERX_URL=http://localhost:8010
OLLAMA_URL=http://localhost:11434
# Ollama CLI (`brew install ollama`, not the menu-bar app) → `npm run ai:ollama` → `ollama pull qwen2.5:3b` (blobs land on the SSD)
# qwen2.5:7b (4.7 GB) is the translation-quality upgrade.
OLLAMA_MODEL=qwen2.5:3b

# Hosted generation + stock (per-project "Media source" decides which is used)
FAL_KEY=
PEXELS_KEY=
