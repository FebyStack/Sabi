{
  "name": "captions-clone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "mkdir -p $HOME/Developer/.sabi-tmp && TMPDIR=$HOME/Developer/.sabi-tmp tsx watch backend/server/index.ts",
    "dev:lite": "mkdir -p $HOME/Developer/.sabi-tmp && TMPDIR=$HOME/Developer/.sabi-tmp tsx watch backend/server/index-lite.ts",
    "mcp": "tsx backend/mcp/index.ts",
    "demo:pack": "tsx infrastructure/dev/pack-demo.ts",
    "build:mg-sandbox": "tsx infrastructure/dev/build-mg-sandbox.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p backend/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "build:server": "esbuild backend/server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/index.mjs",
    "test:py": "UV_CACHE_DIR=${UV_CACHE_DIR:-$PWD/.cache/uv} uv run --no-project --with pytest pytest -q ai/transcription",
    "test:infra": "PG_TEST_URL=postgres://captions:captions@localhost:5433/captions S3_TEST_ENDPOINT=http://localhost:9000 S3_TEST_ACCESS_KEY=minio S3_TEST_SECRET_KEY=minio12345 REDIS_TEST_URL=redis://localhost:6379 vitest run tests/integration/pg.test.ts backend/shared/storage.test.ts backend/shared/bullJobs.test.ts backend/server/boot.test.ts",
    "verify": "npm run typecheck && npm run typecheck:server && npm run test && npm run test:py",
    "prepare": "git config core.hooksPath .githooks || true",
    "deps": "sh infrastructure/dev/deps.sh",
    "transcribe:sample": "RUN_TRANSCRIBE=1 vitest run tests/integration/transcribe.test.ts",
    "pipeline:sample": "RUN_PIPELINE=1 vitest run tests/integration/pipeline.test.ts",
    "render:sample": "mkdir -p $HOME/Developer/.sabi-tmp && RUN_RENDER=1 TMPDIR=$HOME/Developer/.sabi-tmp vitest run tests/integration/render.test.ts",
    "ai:whisperx": "UV_CACHE_DIR=${UV_CACHE_DIR:-$PWD/.cache/uv} HF_HOME=${DATA_DIR:-/Volumes/PortableSSD/Bong/captions-clone-data}/hf TORCH_HOME=${DATA_DIR:-/Volumes/PortableSSD/Bong/captions-clone-data}/torch uv run --directory ai/transcription uvicorn server:app --host 127.0.0.1 --port 8010",
    "ai:ollama": "OLLAMA_MODELS=${DATA_DIR:-/Volumes/PortableSSD/Bong/captions-clone-data}/ollama \"${OLLAMA_BIN:-ollama}\" serve",
    "doctor": "tsx backend/server/doctor.ts",
    "db:migrate": "tsx backend/server/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/lib-storage": "3.1152.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/player": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "@tanstack/react-query": "^5.90.2",
    "bullmq": "6.3.15",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ioredis": "5.11.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0",
    "remotion": "^4.0.536",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
