{
  "name": "captions-clone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "mkdir -p .tmp && TMPDIR=$PWD/.tmp tsx watch backend/server/index.ts",
    "dev:lite": "mkdir -p .tmp && TMPDIR=$PWD/.tmp tsx watch backend/server/index-lite.ts",
    "mcp": "tsx backend/mcp/index.ts",
    "demo:pack": "tsx infrastructure/dev/pack-demo.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p backend/tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "build:server": "esbuild backend/server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist-server/index.cjs --external:pg-native",
    "verify": "npm run typecheck && npm run typecheck:server && npm run test",
    "prepare": "git config core.hooksPath .githooks || true",
    "deps": "sh infrastructure/dev/deps.sh",
    "render:sample": "mkdir -p .tmp && RUN_RENDER=1 TMPDIR=$PWD/.tmp vitest run tests/integration/render.test.ts",
    "ai:whisperx": "UV_CACHE_DIR=${UV_CACHE_DIR:-$PWD/.cache/uv} HF_HOME=${DATA_DIR:-/Volumes/PortableSSD/Bong/captions-clone-data}/hf uv run --directory ai/transcription uvicorn server:app --host 127.0.0.1 --port 8010",
    "ai:ollama": "OLLAMA_MODELS=${DATA_DIR:-/Volumes/PortableSSD/Bong/captions-clone-data}/ollama ollama serve"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/player": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "@tanstack/react-query": "^5.90.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^8.4.0",
    "remotion": "^4.0.536",
    "typescript": "^5.9.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.10",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
